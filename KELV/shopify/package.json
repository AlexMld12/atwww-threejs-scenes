    "@types/node": "^22",
    "@types/three": "0.186.0",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "liquidjs": "^10.30.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0"
  }
