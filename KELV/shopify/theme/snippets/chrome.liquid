{%- doc -%}
  The fixed header and the two CTAs. Rendered twice: light, and dark (clipped to the light sections).

  @param {object} header - The header section's settings
  @param {boolean} [dark] - The dark copy (hidden from assistive technology and the keyboard)
{%- enddoc -%}
{%- liquid
  assign shop_url = header.shop_link | default: routes.all_products_collection_url
  assign quiz_url = header.quiz_link | default: '/pages/skin-analysis'
  assign buy_url = header.buy_link | default: routes.all_products_collection_url
  if dark
    assign tabindex = ' tabindex="-1"'
  endif
-%}
<div
  class="chrome{% if dark %} chrome--dark{% endif %}"
  {% if dark %}
    aria-hidden="true"
  {% endif %}
>
  <header class="site-header">
    <div class="ticks" aria-hidden="true"><span class="ticks__lit"></span></div>
    <div class="head-row">
      <a class="logo" href="{{ routes.root_url }}" aria-label="{{ 'general.home' | t }}" data-page-link{{ tabindex }}>
        {%- render 'logo' -%}
      </a>
      <p class="head-title">
        <span class="head-title__a">{{ header.title_a | escape }}</span>
        <span class="head-title__b">{{ header.title_b | escape }}</span>
      </p>
      <a class="btn-shop" href="{{ shop_url }}" data-roll-host data-page-link{{ tabindex }}>
        {%- render 'roll-text', text: header.shop_label -%}
        {%- render 'icon-arrow' -%}
      </a>
    </div>
  </header>
  <a class="cta mono cta--l" href="{{ quiz_url }}" data-page-link{{ tabindex }}>
    {{- header.quiz_label | escape -}}
    <span class="cta__line" aria-hidden="true"></span>
  </a>
  <a class="cta mono cta--r" href="{{ buy_url }}" data-page-link{{ tabindex }}>
    {{- header.buy_label | escape -}}
    <span class="cta__line" aria-hidden="true"></span>
  </a>
</div>
