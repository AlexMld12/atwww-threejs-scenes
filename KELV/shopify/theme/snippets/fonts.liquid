{%- comment -%} Self-hosted: Archivo and IBM Plex Mono (latin), Archivo Expanded / ExtraCondensed in the weights used. {%- endcomment -%}
{{ 'Archivo-Variable.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{{ 'Archivo-Expanded-Black.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{{
  'Archivo-ExtraCondensed-ExtraBold.woff2'
  | asset_url
  | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true
}}
{{ 'IBMPlexMono-Regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
<style>
  @font-face { font-family: 'Archivo'; font-weight: 400 500; font-display: swap; src: url({{ 'Archivo-Variable.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Archivo Expanded'; font-weight: 800; font-display: swap; src: url({{ 'Archivo-Expanded-ExtraBold.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Archivo Expanded'; font-weight: 900; font-display: swap; src: url({{ 'Archivo-Expanded-Black.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Archivo ExtraCondensed'; font-weight: 700; font-display: swap; src: url({{ 'Archivo-ExtraCondensed-Bold.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'Archivo ExtraCondensed'; font-weight: 800; font-display: swap; src: url({{ 'Archivo-ExtraCondensed-ExtraBold.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'IBM Plex Mono'; font-weight: 400; font-display: swap; src: url({{ 'IBMPlexMono-Regular.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'IBM Plex Mono'; font-weight: 500; font-display: swap; src: url({{ 'IBMPlexMono-Medium.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'IBM Plex Mono'; font-weight: 600; font-display: swap; src: url({{ 'IBMPlexMono-SemiBold.woff2' | asset_url }}) format('woff2'); }
  @font-face { font-family: 'IBM Plex Mono'; font-weight: 700; font-display: swap; src: url({{ 'IBMPlexMono-Bold.woff2' | asset_url }}) format('woff2'); }
  :root {
    --font-archivo: 'Archivo';
    --font-archivo-expanded: 'Archivo Expanded';
    --font-archivo-condensed: 'Archivo ExtraCondensed';
    --font-plex-mono: 'IBM Plex Mono';
  }
</style>
