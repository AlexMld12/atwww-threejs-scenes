{%- liquid
  assign s = section.settings
  assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign consent_url = privacy_url
  if s.consent_anchor != blank
    assign consent_url = privacy_url | append: '#' | append: s.consent_anchor
  endif
  assign title_label = s.title_1 | append: ' ' | append: s.title_2 | append: ' ' | append: s.title_3 | downcase | capitalize
  assign start_label = s.start_button
-%}
<kelv-skin-analysis
  data-why-icon="{{ 'sa-why.svg' | asset_url }}"
  data-kit-icon="{{ 'sa-kit.svg' | asset_url }}"
  data-consent-text="{{ s.consent_text | escape }}"
  data-consent-link="{{ s.consent_link | escape }}"
  data-consent-url="{{ consent_url }}"
>
  {%- comment -%} The contact step, saved as a customer only when the consent box is ticked. {%- endcomment -%}
  <div hidden>
    {%- form 'customer', data-part: 'contact-form' -%}
      <input type="hidden" name="contact[tags]" value="skin-analysis">
      <input type="hidden" name="contact[email]">
      <input type="hidden" name="contact[first_name]">
    {%- endform -%}
  </div>
  {%- comment -%}
    The kit the report adds to the cart: the kit product, or the three step products (kelv.step 1–3).
  {%- endcomment -%}
  <script type="application/json" data-part="kit">
    {
      "kit": [
        {%- if s.kit_product != blank -%}
          {%- render 'kit-item', product: s.kit_product -%}
        {%- else -%}
          {%- assign first = true -%}
          {%- for step in (1..3) -%}
            {%- for product in collections.all.products -%}
              {%- if product.metafields.kelv.step.value == step -%}
                {%- unless first %},{% endunless -%}
                {%- render 'kit-item', product: product -%}
                {%- assign first = false -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      ],
      "k2": {%- assign k2 = null -%}
      {%- for product in collections.all.products -%}
        {%- if product.metafields.kelv.step.value == 2 -%}
          {%- assign k2 = product -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if k2 %}{% render 'kit-item', product: k2 %}{% else %}null{% endif %}
    }
  </script>
  <template data-icon="arrow">{% render 'icon-arrow' %}</template>
  <template data-icon="error">{% render 'icon-error' %}</template>
  <template data-part="start">
    <section class="sa-screen sa-start">
      <h1 class="sa-start__title" aria-label="{{ title_label | escape }}">
        <span class="sa-start__cond" data-sa-in aria-hidden="true">{{ s.title_1 | escape }}</span
        ><span class="sa-start__exp" data-sa-in aria-hidden="true">{{ s.title_2 | escape }}</span
        ><span class="sa-start__cond" data-sa-in aria-hidden="true">{{ s.title_3 | escape }}</span>
      </h1>
      <p class="sa-start__text mono" data-sa-in>{{ s.text_1 | escape }}</p>
      <p class="sa-start__text mono" data-sa-in>{{ s.text_2 | escape }}</p>
      <p class="sa-start__note mono" data-sa-in>{{ s.note | escape }}</p>
      <div data-sa-in>
        <button class="sa-btn sa-btn--primary sa-start__btn" type="button" data-roll-host data-action="start">
          {%- render 'roll-text', text: start_label -%}
          {%- render 'icon-arrow' -%}
        </button>
      </div>
    </section>
  </template>

  <header class="sa-head">
    <a class="sa-logo" href="{{ routes.root_url }}" aria-label="{{ 'general.home' | t }}" data-page-link>
      {%- render 'logo', degree_class: 'sa-logo__deg' -%}
    </a>
    <p class="sa-title" aria-label="{{ s.head_a | append: ' ' | append: s.head_b | downcase | capitalize | escape }}">
      <span class="sa-title__a">{{ s.head_a | escape }}</span><span class="sa-title__b">{{ s.head_b | escape }}</span>
    </p>
    <div class="sa-live" aria-live="polite">
      <span class="sa-live__label mono">{{ s.live_label | escape }}</span>
      <span class="sa-live__row">
        <span class="sa-live__val" data-part="live">––.–</span>
        <i class="sa-deg" aria-hidden="true"></i>
      </span>
    </div>
  </header>
  <ol class="sa-stages" data-part="stages"></ol>
  <div class="sa-body" data-part="body"></div>
</kelv-skin-analysis>

{% schema %}
{
  "name": "Skin analysis",
  "settings": [
    {
      "type": "paragraph",
      "content": "The questions, the reading and the routine follow the quiz logic (in the theme's code)."
    },
    { "type": "text", "id": "head_a", "label": "Header title, first word (orange)", "default": "Skin" },
    { "type": "text", "id": "head_b", "label": "Header title, second word", "default": "Analysis" },
    { "type": "text", "id": "live_label", "label": "Live reading label", "default": "Live reading" },
    { "type": "header", "content": "Start screen" },
    { "type": "text", "id": "title_1", "label": "Title, line 1", "default": "Take your" },
    { "type": "text", "id": "title_2", "label": "Title, line 2 (wide)", "default": "Skin reading" },
    { "type": "text", "id": "title_3", "label": "Title, line 3", "default": "Today!" },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Text",
      "default": "Seven quick questions about your skin and the heat it lives with: sun, training, saunas, screens and city air."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Second text",
      "default": "At the end you get a reading and a routine for the three steps of the KELV° recovery kit."
    },
    { "type": "text", "id": "note", "label": "Note", "default": "Takes about two minutes. No photo needed." },
    { "type": "text", "id": "start_button", "label": "Button", "default": "Start the reading" },
    { "type": "header", "content": "Contact step (7)" },
    {
      "type": "text",
      "id": "consent_text",
      "label": "Consent box",
      "info": "Ticked, the name and email are saved as a customer who accepts emails (tags: skin-analysis, the kit ID).",
      "default": "By submitting, you agree to our"
    },
    { "type": "text", "id": "consent_link", "label": "Consent link", "default": "Privacy policy" },
    {
      "type": "text",
      "id": "consent_anchor",
      "label": "Section of the privacy policy",
      "info": "The heading the link opens at, as it is in the URL: \"Marketing emails\" → marketing-emails. Empty: the top.",
      "default": "marketing-emails"
    },
    { "type": "header", "content": "Cart" },
    {
      "type": "product",
      "id": "kit_product",
      "label": "Recovery kit product",
      "info": "Empty: the three products with kelv.step 1, 2 and 3. A refill uses the product's first selling plan."
    }
  ]
}
{% endschema %}
